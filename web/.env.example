# Base de datos (local: Postgres de Homebrew; producción: Neon desde el Marketplace de Vercel,
# que carga DATABASE_URL —con pool, la usa la app— y DATABASE_URL_UNPOOLED —directa, para migraciones—)
DATABASE_URL="postgresql://USER@localhost:5432/experiencia_tenis"
# DATABASE_URL_UNPOOLED=""

# Base solo para tests de concurrencia (npm run test:db). Se vacía en cada corrida.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/experiencia_tenis_test"

# URL pública del sitio (sin barra final). Opcional en Vercel: si falta, se usa la URL de
# producción del proyecto (VERCEL_PROJECT_PRODUCTION_URL). Definirla cuando haya dominio propio.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Emails transaccionales (Resend). Sin RESEND_API_KEY los emails se loguean en consola.
RESEND_API_KEY=""
EMAIL_FROM="Experiencia Tenis <onboarding@resend.dev>"
# Casilla que recibe los avisos de nuevas altas y consultas
ADMIN_NOTIFY_EMAIL=""

# Sal para hashear IPs en el límite de envíos (cualquier string largo y aleatorio)
RATE_LIMIT_SALT=""

# Panel admin (Auth.js + Google). AUTH_SECRET: `openssl rand -base64 33`.
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: credenciales OAuth de Google Cloud
# (redirect URI: <URL del sitio>/api/auth/callback/google).
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
