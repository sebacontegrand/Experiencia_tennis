# Base de datos (local: Postgres de Homebrew; producción: Neon desde el Marketplace de Vercel,
# que carga DATABASE_URL —con pool, la usa la app— y DATABASE_URL_UNPOOLED —directa, para migraciones—)
DATABASE_URL="postgresql://USER@localhost:5432/experiencia_tenis"
# DATABASE_URL_UNPOOLED=""

# URL pública del sitio (sin barra final). En Vercel: la URL del deploy o el dominio.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Emails transaccionales (Resend). Sin RESEND_API_KEY los emails se loguean en consola.
RESEND_API_KEY=""
EMAIL_FROM="Experiencia Tenis <onboarding@resend.dev>"
# Casilla que recibe los avisos de nuevas altas y consultas
ADMIN_NOTIFY_EMAIL=""

# Sal para hashear IPs en el límite de envíos (cualquier string largo y aleatorio)
RATE_LIMIT_SALT=""
